# Sudo rules for the Bifrost agent, generated by `bifrost-agent operations sudoers`.
# Install as /etc/sudoers.d/bifrost-agent (mode 0440, owner root) and check it with
# `visudo -cf /etc/sudoers.d/bifrost-agent`. Keep only the section for this server's
# package manager if you like.
#
# A sudoers "*" matches any arguments, spaces included. The agent only ever fills
# it with schema-checked arguments (one, or one per item of a package list), but
# anyone who controls the agent's user can run these commands with other arguments:
# protect that user like root.

Defaults:bifrost env_keep += "DEBIAN_FRONTEND"

# Every package manager
# service.disable@1
bifrost ALL=(root) NOPASSWD: /usr/bin/systemctl disable *
# service.enable@1
bifrost ALL=(root) NOPASSWD: /usr/bin/systemctl enable *
# service.reload@1
bifrost ALL=(root) NOPASSWD: /usr/bin/systemctl reload *
# service.restart@1
bifrost ALL=(root) NOPASSWD: /usr/bin/systemctl restart *
# service.start@1
bifrost ALL=(root) NOPASSWD: /usr/bin/systemctl start *
# service.stop@1
bifrost ALL=(root) NOPASSWD: /usr/bin/systemctl stop *
# kernel.remove@1
bifrost ALL=(root) NOPASSWD: /usr/local/bin/bifrost-agent kernel remove *
# php.remove@1
bifrost ALL=(root) NOPASSWD: /usr/local/bin/bifrost-agent php remove *
# php.restore@1
bifrost ALL=(root) NOPASSWD: /usr/local/bin/bifrost-agent php restore *
# apt.source.disable@1
bifrost ALL=(root) NOPASSWD: /usr/local/bin/bifrost-agent release disable *
# packages.remove_obsolete@1
bifrost ALL=(root) NOPASSWD: /usr/local/bin/bifrost-agent release remove-obsolete *
# apt.source.restore@1
bifrost ALL=(root) NOPASSWD: /usr/local/bin/bifrost-agent release restore *
# apt.source.retarget@1
bifrost ALL=(root) NOPASSWD: /usr/local/bin/bifrost-agent release retarget *
# agent.upgrade@1
bifrost ALL=(root) NOPASSWD: /usr/local/lib/bifrost-agent/install.sh --self-upgrade *
# collector.upgrade@1
bifrost ALL=(root) NOPASSWD: /usr/local/lib/bifrost-agent/install.sh --upgrade-collector *
# system.reboot@1
bifrost ALL=(root) NOPASSWD: /usr/sbin/shutdown -r +1

# apt (Debian, Ubuntu)
# package.install@1
bifrost ALL=(root) NOPASSWD: /usr/bin/apt-get -q -y -o Dpkg\:\:Options\:\:\=--force-confdef -o Dpkg\:\:Options\:\:\=--force-confold install --allow-downgrades *
# package.upgrade@1, packages.upgrade@1
bifrost ALL=(root) NOPASSWD: /usr/bin/apt-get -q -y -o Dpkg\:\:Options\:\:\=--force-confdef -o Dpkg\:\:Options\:\:\=--force-confold install --only-upgrade *
# package.refresh@1, state tool pending_updates (read-only)
bifrost ALL=(root) NOPASSWD: /usr/bin/apt-get -q update
# package.hold@1
bifrost ALL=(root) NOPASSWD: /usr/bin/apt-mark hold *
# package.unhold@1
bifrost ALL=(root) NOPASSWD: /usr/bin/apt-mark unhold *
# state tool release_leftovers (read-only)
bifrost ALL=(root) NOPASSWD: /usr/local/bin/bifrost-agent release leftovers
# state tool services_needing_restart (read-only)
bifrost ALL=(root) NOPASSWD: /usr/sbin/needrestart -b -r l

# dnf (RHEL family)
# package.refresh@1, state tool pending_updates (read-only)
bifrost ALL=(root) NOPASSWD: /usr/bin/dnf -q makecache
# state tool services_needing_restart (read-only)
bifrost ALL=(root) NOPASSWD: /usr/bin/dnf -q needs-restarting -s
# package.install@1
bifrost ALL=(root) NOPASSWD: /usr/bin/dnf -y install *
# package.upgrade@1, packages.upgrade@1
bifrost ALL=(root) NOPASSWD: /usr/bin/dnf -y upgrade *
# package.hold@1
bifrost ALL=(root) NOPASSWD: /usr/bin/dnf -y versionlock add *
# package.unhold@1
bifrost ALL=(root) NOPASSWD: /usr/bin/dnf -y versionlock delete *
