# Sudo rules for the Bifrost agent, generated by `bifrost-agent operations sudoers`.
# Install as /etc/sudoers.d/bifrost-agent (mode 0440, owner root) and check it with
# `visudo -cf /etc/sudoers.d/bifrost-agent`. Keep only the section for this server's
# package manager if you like.
#
# A sudoers "*" matches any arguments, spaces included. The agent only ever fills
# it with one schema-checked argument, but anyone who controls the agent's user can
# run these commands with other arguments: protect that user like root.

Defaults:bifrost env_keep += "DEBIAN_FRONTEND"

# Every package manager
# service.reload@1
bifrost ALL=(root) NOPASSWD: /usr/bin/systemctl reload *
# service.restart@1
bifrost ALL=(root) NOPASSWD: /usr/bin/systemctl restart *
# service.start@1
bifrost ALL=(root) NOPASSWD: /usr/bin/systemctl start *
# service.stop@1
bifrost ALL=(root) NOPASSWD: /usr/bin/systemctl stop *

# apt (Debian, Ubuntu)
# package.install@1
bifrost ALL=(root) NOPASSWD: /usr/bin/apt-get -q -y -o Dpkg\:\:Options\:\:\=--force-confdef -o Dpkg\:\:Options\:\:\=--force-confold install --allow-downgrades *
# package.upgrade@1
bifrost ALL=(root) NOPASSWD: /usr/bin/apt-get -q -y -o Dpkg\:\:Options\:\:\=--force-confdef -o Dpkg\:\:Options\:\:\=--force-confold install --only-upgrade *

# dnf (RHEL family)
# package.install@1
bifrost ALL=(root) NOPASSWD: /usr/bin/dnf -y install *
# package.upgrade@1
bifrost ALL=(root) NOPASSWD: /usr/bin/dnf -y upgrade *
