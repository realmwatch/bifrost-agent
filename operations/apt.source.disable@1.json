{
  "name": "apt.source.disable",
  "version": 1,
  "description": "Stop apt using one sources file, such as a third-party source for an older release that doesn't offer the current one. The file is backed up under /var/backups/apt-sources and removed.",
  "min_tier": "medium",
  "params": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "file"
    ],
    "properties": {
      "file": {
        "type": "string",
        "description": "A file in /etc/apt/sources.list.d, such as pgdg.list.",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.(list|sources)$",
        "maxLength": 128
      }
    }
  },
  "rollback": "apt.source.restore",
  "irreversible": false,
  "health_check": "The file is gone and its backup is in place.",
  "files_written": [],
  "agent": {
    "privileged": true,
    "argv": {
      "apt": [
        "/usr/local/bin/bifrost-agent",
        "release",
        "disable",
        "{file}"
      ],
      "dnf": [
        "/usr/local/bin/bifrost-agent",
        "release",
        "disable",
        "{file}"
      ]
    },
    "sudo": {
      "apt": "/usr/local/bin/bifrost-agent release disable *",
      "dnf": "/usr/local/bin/bifrost-agent release disable *"
    },
    "health": {
      "check": "exit_status",
      "args": {}
    }
  }
}
