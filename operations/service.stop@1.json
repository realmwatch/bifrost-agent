{
  "name": "service.stop",
  "version": 1,
  "description": "Stop one systemd service.",
  "min_tier": "medium",
  "params": {
    "type": "object",
    "additionalProperties": false,
    "required": ["unit"],
    "properties": {
      "unit": {"type": "string", "description": "systemd service unit, ending in .service.", "pattern": "^[A-Za-z0-9][A-Za-z0-9:_.@-]*\\.service$", "minLength": 9, "maxLength": 128}
    }
  },
  "rollback": "service.start",
  "irreversible": false,
  "health_check": "The unit's ActiveState is inactive after the stop.",
  "files_written": [],
  "agent": {
    "privileged": true,
    "argv": {
      "apt": ["/usr/bin/systemctl", "stop", "{unit}"],
      "dnf": ["/usr/bin/systemctl", "stop", "{unit}"]
    },
    "sudo": {
      "apt": "/usr/bin/systemctl stop *",
      "dnf": "/usr/bin/systemctl stop *"
    },
    "health": {"check": "service_state", "args": {"unit": "{unit}", "state": "inactive"}}
  }
}
