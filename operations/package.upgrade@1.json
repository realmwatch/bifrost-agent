{
  "name": "package.upgrade",
  "version": 1,
  "description": "Upgrade one installed package to a given version.",
  "min_tier": "medium",
  "params": {
    "type": "object",
    "additionalProperties": false,
    "required": ["name", "to"],
    "properties": {
      "name": {"type": "string", "description": "Package name.", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$", "minLength": 1, "maxLength": 128},
      "to": {"type": "string", "description": "Exact version to upgrade to, as the package manager prints it.", "pattern": "^[0-9][A-Za-z0-9.+~:_-]*$", "minLength": 1, "maxLength": 128}
    }
  },
  "rollback": "package.install",
  "irreversible": false,
  "health_check": "The package is installed at the requested version.",
  "files_written": [],
  "agent": {
    "privileged": true,
    "argv": {
      "apt": ["/usr/bin/apt-get", "-q", "-y", "-o", "Dpkg::Options::=--force-confdef", "-o", "Dpkg::Options::=--force-confold", "install", "--only-upgrade", "{name}={to}"],
      "dnf": ["/usr/bin/dnf", "-y", "upgrade", "{name}-{to}"]
    },
    "dry_run_argv": {
      "apt": ["/usr/bin/apt-get", "-s", "install", "--only-upgrade", "{name}={to}"],
      "dnf": ["/usr/bin/dnf", "-C", "--assumeno", "upgrade", "{name}-{to}"]
    },
    "env": {
      "apt": {"DEBIAN_FRONTEND": "noninteractive"}
    },
    "sudo": {
      "apt": "/usr/bin/apt-get -q -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold install --only-upgrade *",
      "dnf": "/usr/bin/dnf -y upgrade *"
    },
    "health": {"check": "package_version", "args": {"name": "{name}", "version": "{to}"}}
  }
}
